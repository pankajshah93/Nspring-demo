{
  "name": "jenkins-node-demo",
  "version": "1.0.0",
  "description": "Node.js CI/CD practice project",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "build": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\" && esbuild src/server.js --bundle --platform=node --packages=external --outfile=dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.1"
  }
}
